# Supabase project settings — find these in Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only — used by admin server actions that need to bypass RLS
# (e.g. uploading media, creating the first admin user). Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public site URL, used for absolute links (e.g. metadata, emails)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:hello@yourdomain.com
